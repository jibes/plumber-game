<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.jibes.piperunner" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Pipe Runner</name>
    <description>Isometric platformer game</description>
    <author href="https://github.com/jibes/plumber-game">Jibes</author>
    <!-- www/ is generated by `npm run build:android` from build/web; the game is fully offline -->
    <content src="index.html" />
    <preference name="Orientation" value="landscape" />
    <preference name="Fullscreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="35" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
</widget>
